# DecapCMS Configuration for Vinyl Cabinet
# https://decapcms.org/docs/configuration-options/

# Backend configuration
backend:
  name: git-gateway
  branch: main # Branch to update (master or main)
  
# For local development testing, uncomment this instead:
# backend:
#   name: test-repo

# Media files configuration
media_folder: "images/covers" # Where uploaded images will be stored
public_folder: "/images/covers" # Public path for images

# Local backend for development (run: npx decap-server)
local_backend: true

# Site URL (update with your GitHub Pages URL)
site_url: https://yourusername.github.io/vinyl-cabinet
display_url: https://yourusername.github.io/vinyl-cabinet

# Logo (optional)
# logo_url: /images/logo.png

# Collections - Define content types
collections:
  # Vinyl Records Collection  
  - name: "records"
    label: "Vinyl Records"
    label_singular: "Record"
    folder: "data/records"
    create: true
    delete: true
    slug: "{{id}}"
    extension: "json"
    format: "json"
    identifier_field: "id"
    summary: "{{id}} - {{album}}"
    
    # Editor configuration
    editor:
      preview: false
    
    # Sort records by ID descending (newest first)
    sortable_fields: ['id', 'year', 'album']
    
    # Fields for each record
    # Using custom all-in-one vinyl record widget - outputs entire record JSON
    fields:
      - label: "Record ID"
        name: "id"
        widget: "vinyl-record"
        hint: "Complete vinyl record editor with Discogs search"

  # Featured Records Configuration (Homepage)
  - name: "featured"
    label: "Featured Collections"
    label_singular: "Featured Collection"
    files:
      - label: "Homepage Featured Records"
        name: "records"
        file: "data/records.json"
        format: "json"
        fields:
          - label: "Featured Rows"
            name: "rows"
            widget: "list"
            hint: "Configure homepage featured record rows"
            fields:
              - label: "Title"
                name: "title"
                widget: "string"
                
              - label: "Filter Type"
                name: "filterType"
                widget: "select"
                options: ["recent", "genre", "year", "artist", "label", "custom"]
                
              - label: "Filter Value"
                name: "filterValue"
                widget: "string"
                hint: "Value to filter by (or 'recent' for recent additions)"
                
              - label: "Record IDs"
                name: "records"
                widget: "list"
                hint: "List of record IDs to display in this row"
                field:
                  label: "Record ID"
                  name: "recordId"
                  widget: "string"
